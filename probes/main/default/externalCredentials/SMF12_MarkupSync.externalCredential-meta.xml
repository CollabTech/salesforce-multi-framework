<?xml version="1.0" encoding="UTF-8"?>
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <authenticationProtocol>Custom</authenticationProtocol>
    <description>SMF-12 markup sync service mint key. The owner enters the value of the service's SMF12_ROOM_TOKEN_SECRET as the MintKey parameter of principal SMF12Mint in Setup (never in source).</description>
    <externalCredentialParameters>
        <parameterGroup>DefaultGroup</parameterGroup>
        <parameterName>X-SMF-Mint-Key</parameterName>
        <parameterType>AuthHeader</parameterType>
        <parameterValue>{!$Credential.SMF12_MarkupSync.MintKey}</parameterValue>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <parameterGroup>SMF12Mint</parameterGroup>
        <parameterName>SMF12Mint</parameterName>
        <parameterType>NamedPrincipal</parameterType>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <label>SMF-12 Markup Sync</label>
</ExternalCredential>
