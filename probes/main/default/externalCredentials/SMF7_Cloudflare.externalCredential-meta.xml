<?xml version="1.0" encoding="UTF-8"?>
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <authenticationProtocol>Custom</authenticationProtocol>
    <description>SMF-7: Cloudflare API token for RealtimeKit. The secret is not in source control: the owner sets authentication parameter ApiToken on principal SMF7_Principal in Setup (docs/smf-7/realtimekit-setup.md). The Authorization header is built from it at callout time.</description>
    <externalCredentialParameters>
        <parameterGroup>DefaultGroup</parameterGroup>
        <parameterName>Authorization</parameterName>
        <parameterType>AuthHeader</parameterType>
        <parameterValue>{!&apos;Bearer &apos; &amp; $Credential.SMF7_Cloudflare.ApiToken}</parameterValue>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <parameterGroup>SMF7_Principal</parameterGroup>
        <parameterName>SMF7_Principal</parameterName>
        <parameterType>NamedPrincipal</parameterType>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <label>SMF7 Cloudflare</label>
</ExternalCredential>
